{
  "name": "high-performance-planner",
  "version": "2.0.0",
  "description": "A comprehensive task planner with Eisenhower Matrix prioritization",
  "type": "module",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "keywords": [
    "planner",
    "productivity",
    "eisenhower-matrix",
    "task-management"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "transform": {},
    "moduleFileExtensions": ["js", "json"],
    "testMatch": ["**/__tests__/**/*.test.js"],
    "collectCoverageFrom": [
      "js/**/*.js",
      "!js/**/*.test.js"
    ]
  }
}
